    end
end)

-- Find required game modules
local function loadGameModules()
    for _, descendant in ipairs(game:GetDescendants()) do
        if descendant:IsA("ModuleScript") then
            if descendant.Name == "SliderMinigame" then
                pcall(function() sliderMinigameModule = require(descendant) end)
            elseif descendant.Name == "Net" then
                pcall(function() netModule = require(descendant) end)
            end
        end
    end

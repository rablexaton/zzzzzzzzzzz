        showTargetCircle = not showTargetCircle
        if showTargetCircle then
            mobTargetCircleBtn.Text = "🎯 Target Circle [ON]"
            mobTargetCircleBtn.BackgroundColor3 = Color3.fromRGB(200, 20, 20)
            if not targetCircleFrame then
                targetCircleFrame = createTargetCircle(screenGui)
            else
                targetCircleFrame.Visible = true
            end
        else
            mobTargetCircleBtn.Text = "🎯 Target Circle [OFF]"
            mobTargetCircleBtn.BackgroundColor3 = Color3.fromRGB(40, 5, 5)
            if targetCircleFrame then
                targetCircleFrame.Visible = false
            end
        end
    end)
end

-- Hook inventory update signals
Data.hook("items", function()
    if autoDropEnabled then
        task.spawn(dropFilteredFish)
    end
end)

initScript()

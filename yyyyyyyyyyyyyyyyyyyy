local function winMinigame()
    if not sliderMinigameModule then
        loadGameModules()
    end

    if sliderMinigameModule then
        if sliderMinigameModule.win then
            if type(sliderMinigameModule.win) == "table" and sliderMinigameModule.win.Fire then
                sliderMinigameModule.win:Fire(true)
                return true
            elseif type(sliderMinigameModule.win) == "function" then
                sliderMinigameModule.win(true)
                return true
            end
        end
    end

    pcall(function()
        local minigameObj = ReplicatedStorage:FindFirstChild("SliderMinigame", true)
        if minigameObj then
            local required = require(minigameObj)
            if required and required.win then
                if required.win.Fire then
                    required.win:Fire(true)
                else
                    required.win(true)
                end
            end
        end
    end)
    return false
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed or isSettingKey then return end
    if input.KeyCode == toggleKey then
        winMinigame()
    end
end)

local function isMinigameActive()
    if not sliderMinigameModule or not sliderMinigameModule.enabled or not sliderMinigameModule.enabled.get then
        return false
    end
    return sliderMinigameModule.enabled.get() == true
end

-- Universal Perform Click Function (PC + Mobile support)
local function performClick()
    local posX, posY

    if deviceType == "PC" then
        local mousePos = UserInputService:GetMouseLocation()
        posX = mousePos.X
        posY = mousePos.Y
    elseif showTargetCircle and targetCircleFrame and targetCircleFrame.Parent then
        local absPos = targetCircleFrame.AbsolutePosition
        local absSize = targetCircleFrame.AbsoluteSize
        local guiInset = GuiService:GetGuiInset()
        
        posX = absPos.X + (absSize.X / 2)
        posY = absPos.Y + (absSize.Y / 2) + guiInset.Y
    else
        local viewport = workspace.CurrentCamera.ViewportSize
        posX, posY = viewport.X / 2, viewport.Y / 2
    end

    -- Method 1: VirtualInputManager Touch (Compatibilité Mobile)
    pcall(function()
        VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin, Vector2.new(posX, posY))
        task.wait(0.02)
        VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End, Vector2.new(posX, posY))
    end)

    -- Method 2: Mouse Event Fallback
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, true, game, 1)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, false, game, 1)
    end)

    -- Method 3: VirtualUser Fallback
    pcall(function()
        VirtualUser:ClickButton1(Vector2.new(posX, posY), workspace.CurrentCamera.CFrame)
    end)
end

